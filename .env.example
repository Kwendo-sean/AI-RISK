# Copy to .env and fill in. Nothing here is required for a local run.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production / Docker). Leave unset to use SQLite.
DATABASE_URL=postgresql://willaijob:change-me@db:5432/willaijob
# SQLite path, used only when DATABASE_URL is unset (local dev, Raspberry Pi).
DB_PATH=willaijob.db
# asyncpg pool per worker. pool_max x workers must stay below Postgres max_connections.
PG_POOL_MIN=2
PG_POOL_MAX=12
PG_COMMAND_TIMEOUT=10

# ── Web ──────────────────────────────────────────────────────────────────────
# Comma-separated. Set to your real domain in production.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PUBLIC_URL=https://yourdomain.example
# Uvicorn workers. Rule of thumb: (2 x CPU cores) + 1, capped by the pool budget.
WEB_CONCURRENCY=4
PORT=8000

# ── Retention ────────────────────────────────────────────────────────────────
PROFILE_TTL_DAYS=90

# ── Results email (Resend) ───────────────────────────────────────────────────
# With no key the app still records leads and queues mail; it just never sends.
RESEND_API_KEY=
EMAIL_FROM=Future Skills <results@yourdomain.example>
EMAIL_REPLY_TO=hello@yourdomain.example
EMAIL_FLUSH_SECONDS=15
EMAIL_FLUSH_BATCH=20
EMAIL_MAX_ATTEMPTS=5

# ── Optional AI enrichment ───────────────────────────────────────────────────
# Anthropic is optional; without it the scan uses deterministic static output.
ANTHROPIC_API_KEY=
# Local model on the Raspberry Pi (Ollama). Leave unset to disable.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:1b
